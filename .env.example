# Copy to .env and fill in. Never commit .env.

# Port for the web server
PORT=5174

# Where the SQLite database lives (created automatically)
DATABASE_PATH=./data/magubane.db

# AI tutor. Without a key the tutor shows a "not connected" state; everything else works.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
# Messages per learner per day (cost and safety cap)
TUTOR_DAILY_LIMIT=80

# Total tutor messages across the whole site per 24 hours (protects your API bill)
TUTOR_GLOBAL_DAILY_LIMIT=600

# Who can sign up: invite (needs a code below), open, or closed. Defaults to invite in production.
SIGNUP_MODE=open
# Comma-separated access codes for the invite-only pilot
INVITE_CODES=
# Shown on the privacy page for data requests
CONTACT_EMAIL=
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx)
TRUST_PROXY=0
