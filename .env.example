# Copy to .env and fill in. Never commit .env.

# Port for the web server
PORT=5174

# Where the SQLite database lives (created automatically)
DATABASE_PATH=./data/magubane.db

# AI tutor. Without a key the tutor shows a "not connected" state; everything else works.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-5-5
# Messages per learner per day (cost and safety cap)
TUTOR_DAILY_LIMIT=80

# Total tutor messages across the whole site per 24 hours (protects your API bill)
TUTOR_GLOBAL_DAILY_LIMIT=600

# Who can sign up: invite (needs a code below), open, or closed. Defaults to invite in production.
SIGNUP_MODE=open
# Comma-separated access codes for the invite-only pilot
INVITE_CODES=
# Shown on the privacy page for data requests
CONTACT_EMAIL=
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx)
TRUST_PROXY=0

# Server clock. Streaks, "today" and weekly reports use South African time.
TZ=Africa/Johannesburg

# Teacher (educator) accounts: comma-separated codes that unlock teacher sign-up at /signup/teacher
EDUCATOR_CODES=

# Email: sign-up codes, password resets and weekly PDF reports.
# EMAIL_PROVIDER is brevo or resend. Leave it blank in development: emails are printed to the server log instead.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be a sender address (or domain) you have verified with the provider
EMAIL_FROM=
EMAIL_FROM_NAME=Magubane Labs
# Public address of the site, used for links in emails (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=

# Weekly progress reports to guardians and teachers (0 = Sunday; hour in South African time). REPORTS_ENABLED=0 turns them off.
REPORT_DAY=0
REPORT_HOUR=17
REPORTS_ENABLED=1
