# Copy to .env and fill in. Never commit .env.

# Port for the web server
PORT=5174

# Where the SQLite database lives (created automatically)
DATABASE_PATH=./data/magubane.db

# AI tutor. Without a key the tutor shows a "not connected" state; everything else works.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
# Messages per learner per day (cost and safety cap)
TUTOR_DAILY_LIMIT=80
