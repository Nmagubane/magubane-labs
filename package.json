{
  "name": "magubane-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Magubane Labs — interactive mathematics and science learning. Build the minds that build the future.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning --import tsx src/server/seed-demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "katex": "0.16.47",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
